# Host of the radium-backend API (see ../radium-backend). The client appends
# /api/v1 itself — do not include the path prefix here.
#
# Local dev, backend on the LAN:
VITE_API_BASE_URL=http://172.17.3.171:8000
#
# Local dev, backend on the same machine:
# VITE_API_BASE_URL=http://localhost:8000
#
# Production:
# VITE_API_BASE_URL=https://radium-backend-1.onrender.com

# Admin console (src/admin, served at /admin) — same host as above but the
# admin expects the /api/v1 prefix included.
VITE_API_URL=http://172.17.3.171:8000/api/v1
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_API_URL=https://radium-backend-1.onrender.com/api/v1
