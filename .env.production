# Baked into `npm run build` output (dist/ is tracked and deployed as-is).
# Mode-specific, so it outranks the gitignored .env — a production bundle
# must never ship a developer's LAN address as the API host.
# `npm run dev` ignores this file and keeps using .env.
VITE_API_BASE_URL=https://radium-backend-1.onrender.com
